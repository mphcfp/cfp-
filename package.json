{
  "name": "aura-creative-studio",
  "version": "1.0.0",
  "private": true,
  "description": "AURA creative studio — a Next.js App Router website",
  "scripts": {
    "dev": "next dev",
    "build": "npm run package:source && next build",
    "build:static": "npm run package:source && AURA_STATIC_EXPORT=1 next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "package:source": "node scripts/package-source.mjs"
  },
  "engines": { "node": ">=20.9.0" },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fflate": "0.8.3",
    "typescript": "5.9.3"
  }
}
